# Example environment variables for the contact server
# Copy this to .env and fill in real values before starting the server

# SMTP configuration (example using standard SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password

# Email recipient for contact form submissions
CONTACT_TO=

# Optional: Brevo (Sendinblue) API key. If set, the server will prefer Brevo.
BREVO_API_KEY=
BREVO_FROM=you@yourdomain.com

# Optional: Brevo SMTP fallback (use if you prefer SMTP instead of API key)
# You can get these in your Brevo (Sendinblue) SMTP settings. If set, the server
# will use these values when `BREVO_API_KEY` is not present.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_smtp_user
BREVO_SMTP_PASS=your_smtp_password
